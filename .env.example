# .env.example — Juris Lex
# INSTRUCCIONES:
#   1. Copiar este archivo como ".env" (sin el .example)
#   2. Completar con tus credenciales reales
#   3. NUNCA subir .env a Git (ya está en .gitignore)

# ── Supabase (BD en la nube) ───────────────────────────────────────────────
# Obtener en: https://supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://TU_PROYECTO_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_ANON_KEY_AQUI

# ── Modo de desarrollo ─────────────────────────────────────────────────────
# Poner DEBUG=1 para activar usuarios demo y logs detallados
# En produccion: no incluir esta variable (o DEBUG=0)
DEBUG=1

# ── MercadoPago (pagos) ────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=APP_USR-TU_TOKEN_AQUI
MP_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_AQUI
