#:import dp kivy.metrics.dp

<UbicacionScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # HEADER
        BoxLayout:
            size_hint_y: None
            height: dp(58)
            padding: [dp(16), dp(10)]
            canvas.before:
                Color:
                    rgba: 0.24, 0.17, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "DONDE BUSCAR"
                font_size: "17sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "center"
                valign: "middle"
                text_size: (self.width, None)

        # CONTENIDO
        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(28), dp(20), dp(20)]
                spacing: dp(16)

                Label:
                    text: "Elegí donde querés buscar tu abogado"
                    font_size: "15sp"
                    color: 0.35, 0.38, 0.50, 1
                    halign: "center"
                    valign: "middle"
                    size_hint_y: None
                    height: dp(28)
                    text_size: (self.width, None)

                # PROVINCIA
                Label:
                    text: "PROVINCIA"
                    font_size: "11sp"
                    bold: True
                    color: 0.45, 0.48, 0.60, 1
                    halign: "left"
                    valign: "middle"
                    size_hint_y: None
                    height: dp(18)
                    text_size: (self.width, None)

                Button:
                    id: btn_provincia
                    text: "Elegí la provincia"
                    size_hint_y: None
                    height: dp(52)
                    font_size: "15sp"
                    bold: True
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    color: 0.24, 0.17, 0.55, 1
                    halign: "left"
                    text_size: (self.width - dp(32), None)
                    padding: [dp(16), dp(10)]
                    on_release: root.abrir_provincias()

                # CIUDAD
                Label:
                    text: "CIUDAD / DEPARTAMENTO"
                    font_size: "11sp"
                    bold: True
                    color: 0.45, 0.48, 0.60, 1
                    halign: "left"
                    valign: "middle"
                    size_hint_y: None
                    height: dp(18)
                    text_size: (self.width, None)

                Button:
                    id: btn_ciudad
                    text: "Elegí la ciudad"
                    size_hint_y: None
                    height: dp(52)
                    font_size: "15sp"
                    bold: True
                    disabled: True
                    opacity: 0.45
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    color: 0.24, 0.17, 0.55, 1
                    halign: "left"
                    text_size: (self.width - dp(32), None)
                    padding: [dp(16), dp(10)]
                    on_release: root.abrir_ciudades()

                Widget:
                    size_hint_y: None
                    height: dp(24)

                # BUSCAR
                Button:
                    id: btn_buscar
                    text: "BUSCAR ABOGADOS"
                    size_hint_y: None
                    height: dp(56)
                    font_size: "17sp"
                    bold: True
                    disabled: True
                    opacity: 0.45
                    background_normal: ""
                    background_color: 0.24, 0.17, 0.55, 1
                    color: 1, 1, 1, 1
                    on_release: root.buscar()

                # TODO EL PAIS
                Button:
                    text: "Buscar en todo el pais"
                    size_hint_y: None
                    height: dp(44)
                    font_size: "14sp"
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: 0.45, 0.48, 0.60, 1
                    on_release: root.buscar_todas()

                Button:
                    text: "< Volver"
                    size_hint_y: None
                    height: dp(40)
                    font_size: "13sp"
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: 0.55, 0.58, 0.68, 1
                    on_release: root.volver()
