<PagoMPScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # TOPBAR
        BoxLayout:
            size_hint_y: None
            height: 58
            padding: [12, 10, 16, 10]
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint_x: None
                width: 36
                font_size: 22
                bold: True
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_release: root.volver()

            Label:
                text: "PAGAR CON MERCADOPAGO"
                font_size: 14
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

        # INFO ABOGADO
        BoxLayout:
            size_hint_y: None
            height: 50
            padding: [20, 12]
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.88, 0.90, 0.93, 1
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: 0.8

            Label:
                id: lbl_abogado_mp
                text: ""
                font_size: 13
                color: 0.40, 0.45, 0.55, 1
                halign: "left"
                text_size: self.size

        # CARD PRECIO
        BoxLayout:
            orientation: "vertical"
            padding: [24, 30, 24, 20]
            spacing: 14

            # Logo MP simulado
            Label:
                text: "MercadoPago"
                font_size: 22
                bold: True
                color: 0.00, 0.60, 0.88, 1
                size_hint_y: None
                height: 40
                halign: "center"
                text_size: self.size

            Label:
                id: lbl_precio_mp
                text: "$0"
                font_size: 58
                bold: True
                color: 0.10, 0.12, 0.18, 1
                size_hint_y: None
                height: 80
                halign: "center"
                text_size: self.size

            Label:
                id: lbl_tipo_mp
                text: ""
                font_size: 14
                color: 0.45, 0.50, 0.58, 1
                size_hint_y: None
                height: 28
                halign: "center"
                text_size: self.size

            # Estado de la preferencia
            Label:
                id: lbl_estado_mp
                text: ""
                font_size: 12
                color: 0.55, 0.58, 0.65, 1
                size_hint_y: None
                height: 24
                halign: "center"
                text_size: self.size

            Widget:
                size_hint_y: None
                height: 8

            # BOTON IR A MERCADOPAGO
            Button:
                id: btn_ir_mp
                text: "Ir a pagar en MercadoPago"
                size_hint_y: None
                height: 58
                bold: True
                font_size: 16
                background_normal: ""
                background_color: 0.00, 0.60, 0.88, 1
                color: 1, 1, 1, 1
                disabled: True
                on_release: root.ir_a_pagar()

            # BOTON CONFIRMAR (post-pago o demo)
            Button:
                id: btn_confirmar
                text: "Ya pague - Continuar"
                size_hint_y: None
                height: 52
                bold: True
                font_size: 15
                background_normal: ""
                background_color: 0.18, 0.80, 0.44, 1
                color: 1, 1, 1, 1
                disabled: True
                on_release: root.confirmar_pago()

            Label:
                text: "Pagos procesados de forma segura por MercadoPago"
                font_size: 11
                color: 0.60, 0.63, 0.70, 1
                size_hint_y: None
                height: 22
                halign: "center"
                text_size: self.size

            Widget:
