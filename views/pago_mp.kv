<PagoMPScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [12, 12, 16, 12]
            canvas.before:
                Color:
                    rgba: 0.24, 0.17, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint_x: None
                width: 36
                font_size: 22
                bold: True
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_release: root.volver()

            Label:
                text: "PAGAR CON MERCADOPAGO"
                font_size: 15
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

        # INFO ABOGADO
        BoxLayout:
            size_hint_y: None
            height: 48
            padding: [20, 12]
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                id: lbl_abogado_mp
                text: ""
                font_size: 13
                color: 0.45, 0.40, 0.58, 1
                halign: "left"
                text_size: self.size

        # CARD PAGO
        BoxLayout:
            orientation: "vertical"
            padding: [24, 28, 24, 20]
            spacing: 14

            Label:
                text: "MercadoPago"
                font_size: 24
                bold: True
                color: 0.00, 0.55, 0.88, 1
                size_hint_y: None
                height: 44
                halign: "center"
                text_size: self.size

            Label:
                id: lbl_precio_mp
                text: "$0"
                font_size: 60
                bold: True
                color: 0.24, 0.17, 0.55, 1
                size_hint_y: None
                height: 84
                halign: "center"
                text_size: self.size

            Label:
                id: lbl_tipo_mp
                text: ""
                font_size: 15
                color: 0.45, 0.40, 0.58, 1
                size_hint_y: None
                height: 30
                halign: "center"
                text_size: self.size

            Label:
                id: lbl_estado_mp
                text: ""
                font_size: 12
                color: 0.55, 0.50, 0.65, 1
                size_hint_y: None
                height: 24
                halign: "center"
                text_size: self.size

            Widget:
                size_hint_y: None
                height: 6

            Button:
                id: btn_ir_mp
                text: "Ir a pagar en MercadoPago"
                size_hint_y: None
                height: 58
                bold: True
                font_size: 16
                background_normal: ""
                background_color: 0.00, 0.55, 0.88, 1
                color: 1, 1, 1, 1
                disabled: True
                on_release: root.ir_a_pagar()

            Button:
                id: btn_confirmar
                text: "Ya pague - Continuar"
                size_hint_y: None
                height: 52
                bold: True
                font_size: 15
                background_normal: ""
                background_color: 0.30, 0.23, 0.67, 1
                color: 1, 1, 1, 1
                disabled: True
                on_release: root.confirmar_pago()

            Label:
                text: "Pagos procesados de forma segura"
                font_size: 11
                color: 0.60, 0.57, 0.68, 1
                size_hint_y: None
                height: 22
                halign: "center"
                text_size: self.size

            Widget:
