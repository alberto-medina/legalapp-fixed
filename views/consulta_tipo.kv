<ConsultaTipoScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 58
            padding: [12, 10, 16, 10]
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint_x: None
                width: 36
                font_size: 22
                bold: True
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_release: root.volver()

            Label:
                text: "TIPO DE CONSULTA"
                font_size: 16
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

        # BANNER ESTADO
        BoxLayout:
            size_hint_y: None
            height: 38
            padding: [16, 8]
            canvas.before:
                Color:
                    rgba: 0.94, 0.96, 0.97, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                id: lbl_banner
                text: ""
                font_size: 12
                bold: True
                halign: "center"
                text_size: self.size

        # SERVICIOS
        BoxLayout:
            orientation: "vertical"
            padding: [16, 20, 16, 16]
            spacing: 14

            # CHAT
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 86
                spacing: 4

                Button:
                    id: btn_chat
                    text: "Chat"
                    size_hint_y: None
                    height: 60
                    bold: True
                    font_size: 15
                    background_normal: ""
                    background_color: 0.18, 0.80, 0.44, 1
                    color: 1, 1, 1, 1
                    on_release: root.seleccionar("chat")

                Label:
                    id: lbl_chat_estado
                    text: ""
                    size_hint_y: None
                    height: 18
                    font_size: 11
                    halign: "center"
                    text_size: self.size

            # VIDEO
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 86
                spacing: 4

                Button:
                    id: btn_video
                    text: "Videollamada"
                    size_hint_y: None
                    height: 60
                    bold: True
                    font_size: 15
                    background_normal: ""
                    background_color: 0.18, 0.80, 0.44, 1
                    color: 1, 1, 1, 1
                    on_release: root.seleccionar("video")

                Label:
                    id: lbl_video_estado
                    text: ""
                    size_hint_y: None
                    height: 18
                    font_size: 11
                    halign: "center"
                    text_size: self.size

            # URGENTE
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 86
                spacing: 4

                Button:
                    id: btn_urgente
                    text: "URGENTE"
                    size_hint_y: None
                    height: 60
                    bold: True
                    font_size: 15
                    background_normal: ""
                    background_color: 0.91, 0.30, 0.24, 1
                    color: 1, 1, 1, 1
                    on_release: root.seleccionar("urgente")

                Label:
                    id: lbl_urgente_estado
                    text: ""
                    size_hint_y: None
                    height: 18
                    font_size: 11
                    halign: "center"
                    text_size: self.size

            Widget:

        Button:
            text: "Volver"
            size_hint_y: None
            height: 48
            font_size: 13
            background_color: 0, 0, 0, 0
            color: 0.45, 0.50, 0.58, 1
            on_release: root.volver()
