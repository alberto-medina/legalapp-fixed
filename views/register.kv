<RegisterScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: "60dp"
            padding: ["20dp", "12dp"]
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Crear cuenta"
                font_size: "20sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: "4dp"

            BoxLayout:
                orientation: "vertical"
                padding: ["20dp", "20dp", "20dp", "100dp"]
                spacing: "12dp"
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "Registrate en Legal App"
                    font_size: "14sp"
                    color: 0.45, 0.50, 0.58, 1
                    size_hint_y: None
                    height: "28dp"
                    halign: "left"
                    text_size: self.size

                Widget:
                    size_hint_y: None
                    height: "8dp"

                # ===== NOMBRE =====
                Label:
                    text: "NOMBRE COMPLETO *"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: username
                    hint_text: "Tu nombre completo"
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== EMAIL =====
                Label:
                    text: "EMAIL *"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: email
                    hint_text: "tu@email.com"
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== DNI =====
                Label:
                    text: "DNI"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: dni
                    hint_text: "Tu DNI (7-8 dígitos, opcional)"
                    multiline: False
                    input_filter: 'int'
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== TELÉFONO =====
                Label:
                    text: "TELEFONO"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: telefono
                    hint_text: "+54 9 xxx-xxxxxxx"
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== DIRECCIÓN =====
                Label:
                    text: "DIRECCION"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: direccion
                    hint_text: "Tu dirección (opcional)"
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== CONTRASEÑA =====
                Label:
                    text: "CONTRASENA *"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: password
                    hint_text: "Mínimo 8 caracteres, 1 mayúscula, 1 número, 1 especial"
                    password: True
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== REPETIR CONTRASEÑA =====
                Label:
                    text: "REPETIR CONTRASENA *"
                    font_size: "11sp"
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: "18dp"
                    halign: "left"
                    text_size: self.size

                TextInput:
                    id: password_confirm
                    hint_text: "Repetí tu contraseña"
                    password: True
                    multiline: False
                    size_hint_y: None
                    height: "48dp"
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.10, 0.12, 0.18, 1
                    hint_text_color: 0.60, 0.63, 0.70, 1
                    cursor_color: 0.18, 0.80, 0.44, 1
                    padding: ["14dp", "14dp"]
                    font_size: "15sp"
                    write_tab: False

                # ===== INFO DE SEGURIDAD =====
                Label:
                    text: "La contraseña debe tener: 8+ caracteres, 1 mayúscula, 1 minúscula, 1 número, 1 especial (!@#$...)"
                    font_size: "10sp"
                    color: 0.60, 0.63, 0.70, 1
                    size_hint_y: None
                    height: "36dp"
                    halign: "left"
                    text_size: self.size

                # ===== ERROR =====
                Label:
                    id: error
                    text: ""
                    color: 0.90, 0.25, 0.25, 1
                    size_hint_y: None
                    height: "40dp"
                    halign: "left"
                    text_size: self.size

                Widget:
                    size_hint_y: None
                    height: "8dp"

                # ===== BOTÓN CREAR CUENTA =====
                Button:
                    text: "Crear cuenta"
                    size_hint_y: None
                    height: "52dp"
                    bold: True
                    font_size: "16sp"
                    background_normal: ""
                    background_color: 0.18, 0.80, 0.44, 1
                    color: 1, 1, 1, 1
                    on_release: root.register()

                # ===== BOTÓN VOLVER =====
                Button:
                    text: "Ya tengo cuenta"
                    size_hint_y: None
                    height: "44dp"
                    font_size: "14sp"
                    background_color: 0, 0, 0, 0
                    color: 0.45, 0.50, 0.58, 1
                    on_release: root.go_back()