<DashboardScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # TOPBAR
        BoxLayout:
            size_hint_y: None
            height: 62
            padding: [20, 12, 20, 12]
            canvas.before:
                Color:
                    rgba: 0.12, 0.16, 0.23, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "LEGAL APP"
                font_size: 22
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

            BoxLayout:
                orientation: "vertical"
                Label:
                    id: lbl_bienvenida
                    text: ""
                    font_size: 14
                    bold: True
                    color: 1, 1, 1, 1
                    halign: "right"
                    text_size: self.size
                Label:
                    text: "Cliente"
                    font_size: 11
                    color: 0.75, 0.80, 0.90, 1
                    halign: "right"
                    text_size: self.size

        # HERO CARD
        BoxLayout:
            size_hint_y: None
            height: 140
            padding: [16, 14, 16, 10]

            canvas.before:
                # sombra
                Color:
                    rgba: 0,0,0,0.08
                RoundedRectangle:
                    pos: self.x, self.y-4
                    size: self.size
                    radius: [18]

                # fondo
                Color:
                    rgba: 0.12, 0.16, 0.23, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]

            BoxLayout:
                orientation: "vertical"
                spacing: 8

                Label:
                    text: "Buenos dias"
                    font_size: 14
                    color: 0.75, 0.80, 0.90, 1
                    halign: "left"
                    text_size: self.size

                Label:
                    text: "Como podemos ayudarte hoy?"
                    font_size: 20
                    bold: True
                    color: 1, 1, 1, 1
                    halign: "left"
                    text_size: self.size

                Button:
                    text: "Nueva Consulta"
                    size_hint_y: None
                    height: 48
                    bold: True
                    font_size: 16
                    background_normal: ""
                    background_color: 0.13, 0.77, 0.37, 1
                    color: 1, 1, 1, 1
                    on_release: root.nueva_consulta()

        # ACCIONES RAPIDAS
        ScrollView:
            BoxLayout:
                orientation: "vertical"
                padding: [16, 18, 16, 90]
                spacing: 14
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: "Acciones rapidas"
                    font_size: 13
                    bold: True
                    color: 0.40, 0.45, 0.55, 1
                    size_hint_y: None
                    height: 24
                    halign: "left"
                    text_size: self.size

                # CARD Historial
                BoxLayout:
                    size_hint_y: None
                    height: 80
                    padding: [16, 14]
                    spacing: 14

                    canvas.before:
                        # sombra
                        Color:
                            rgba: 0,0,0,0.05
                        RoundedRectangle:
                            pos: self.x, self.y-3
                            size: self.size
                            radius: [16]

                        # card
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16]

                    BoxLayout:
                        orientation: "vertical"
                        Label:
                            text: "Mis Consultas"
                            font_size: 15
                            bold: True
                            color: 0.12, 0.16, 0.23, 1
                            halign: "left"
                            text_size: self.size
                        Label:
                            text: "Ver historial y estado"
                            font_size: 12
                            color: 0.50, 0.55, 0.65, 1
                            halign: "left"
                            text_size: self.size

                    Button:
                        text: "Ver"
                        size_hint_x: None
                        width: 75
                        bold: True
                        font_size: 14
                        background_normal: ""
                        background_color: 0.12, 0.16, 0.23, 1
                        color: 1, 1, 1, 1
                        on_release: root.ver_historial()

                # CARD Perfil
                BoxLayout:
                    size_hint_y: None
                    height: 80
                    padding: [16, 14]
                    spacing: 14

                    canvas.before:
                        Color:
                            rgba: 0,0,0,0.05
                        RoundedRectangle:
                            pos: self.x, self.y-3
                            size: self.size
                            radius: [16]

                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16]

                    BoxLayout:
                        orientation: "vertical"
                        Label:
                            text: "Mi Perfil"
                            font_size: 15
                            bold: True
                            color: 0.12, 0.16, 0.23, 1
                            halign: "left"
                            text_size: self.size
                        Label:
                            text: "Editar datos personales"
                            font_size: 12
                            color: 0.50, 0.55, 0.65, 1
                            halign: "left"
                            text_size: self.size

                    Button:
                        text: "Editar"
                        size_hint_x: None
                        width: 75
                        bold: True
                        font_size: 14
                        background_normal: ""
                        background_color: 0.12, 0.16, 0.23, 1
                        color: 1, 1, 1, 1
                        on_release: root.ir_perfil()

        # BOTTOM NAV
        BoxLayout:
            size_hint_y: None
            height: 62

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

                Color:
                    rgba: 0.88, 0.89, 0.91, 1
                Line:
                    points: [self.x, self.top, self.right, self.top]
                    width: 1

            Button:
                text: "Inicio"
                font_size: 12
                bold: True
                background_color: 0, 0, 0, 0
                color: 0.12, 0.16, 0.23, 1

            Button:
                text: "Consultas"
                font_size: 12
                background_color: 0, 0, 0, 0
                color: 0.55, 0.58, 0.65, 1
                on_release: root.ver_historial()

            Button:
                text: "Perfil"
                font_size: 12
                background_color: 0, 0, 0, 0
                color: 0.55, 0.58, 0.65, 1
                on_release: root.ir_perfil()

            Button:
                text: "Salir"
                font_size: 12
                background_color: 0, 0, 0, 0
                color: 0.85, 0.30, 0.30, 1
                on_release: root.cerrar_sesion()