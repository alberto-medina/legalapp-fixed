#:import dp kivy.metrics.dp

<PrivacyScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # HEADER
        BoxLayout:
            size_hint_y: None
            height: "70dp"
            padding: ["16dp", "10dp"]
            spacing: "10dp"
            canvas.before:
                Color:
                    rgba: 0.23, 0.18, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint: None, None
                size: "36dp", "36dp"
                font_size: "18sp"
                bold: True
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_release: root.volver()

            Label:
                text: "POLITICA DE PRIVACIDAD"
                font_size: "17sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: "3dp"

            BoxLayout:
                orientation: "vertical"
                padding: ["18dp", "18dp", "18dp", "40dp"]
                spacing: "12dp"
                size_hint_y: None
                height: self.minimum_height

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["16dp", "16dp"]
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(14)]

                    Label:
                        id: privacy_label
                        text: ""
                        font_size: "13sp"
                        color: 0.15, 0.18, 0.25, 1
                        halign: "left"
                        valign: "top"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                Button:
                    text: "Volver"
                    size_hint_y: None
                    height: "52dp"
                    bold: True
                    font_size: "15sp"
                    background_normal: ""
                    background_color: 0.23, 0.18, 0.55, 1
                    color: 1, 1, 1, 1
                    on_release: root.volver()
