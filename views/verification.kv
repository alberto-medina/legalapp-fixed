<VerificationScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(140)
            padding: dp(20), dp(24)
            spacing: dp(4)
            canvas.before:
                Color:
                    rgba: 0.24, 0.17, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Widget:
                size_hint_y: 0.3

            Label:
                text: "VERIFICACIÓN"
                font_size: "28sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: dp(40)

            Label:
                text: "Activá tu cuenta"
                font_size: "14sp"
                color: 0.85, 0.82, 0.96, 1
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: dp(20)

            Widget:
                size_hint_y: 0.2

        FloatLayout:

            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                width: min(root.width * 0.88, dp(430))
                height: dp(360)
                pos_hint: {"center_x": 0.5, "top": 0.95}
                padding: dp(26), dp(26)
                spacing: dp(16)

                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.07
                    RoundedRectangle:
                        pos: self.x, self.y - dp(3)
                        size: self.size
                        radius: [dp(24)]

                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(24)]

                Label:
                    id: info_label
                    text: "Verificación de Email"
                    font_size: "14sp"
                    color: 0.40, 0.45, 0.55, 1
                    halign: "center"
                    valign: "middle"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(80)

                TextInput:
                    id: codigo
                    hint_text: "Código de 6 dígitos"
                    input_filter: 'int'
                    multiline: False
                    font_size: "24sp"
                    halign: "center"
                    size_hint_y: None
                    height: dp(56)
                    padding: dp(14), dp(16)
                    background_normal: ""
                    background_active: ""
                    background_color: 0.95, 0.94, 0.97, 1
                    foreground_color: 0.10, 0.06, 0.14, 1
                    hint_text_color: 0.60, 0.57, 0.68, 1
                    cursor_color: 0.30, 0.23, 0.67, 1

                Label:
                    id: error
                    text: ""
                    color: 0.90, 0.25, 0.25, 1
                    font_size: "13sp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.width, None
                    size_hint_y: None
                    height: dp(40)

                Widget:

                Button:
                    text: "Verificar"
                    size_hint_y: None
                    height: dp(56)
                    font_size: "18sp"
                    bold: True
                    background_normal: ""
                    background_down: ""
                    background_color: 0.30, 0.23, 0.67, 1
                    color: 1, 1, 1, 1
                    on_release: root.verificar_codigo()

                Button:
                    text: "Reenviar código"
                    size_hint_y: None
                    height: dp(48)
                    font_size: "14sp"
                    background_normal: ""
                    background_down: ""
                    background_color: 1, 1, 1, 1
                    color: 0.30, 0.23, 0.67, 1
                    on_release: root.reenviar_codigo()

                Button:
                    text: "Volver al login"
                    size_hint_y: None
                    height: dp(44)
                    font_size: "14sp"
                    background_color: 0, 0, 0, 0
                    color: 0.45, 0.50, 0.58, 1
                    on_release: root.ir_a_login()