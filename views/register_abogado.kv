<RegisterAbogadoScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: "70dp"
            padding: ["16dp", "10dp"]
            spacing: "10dp"
            canvas.before:
                Color:
                    rgba: 0.23, 0.18, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint: None, None
                size: "36dp", "36dp"
                font_size: "18sp"
                bold: True
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_release: root.volver()

            Label:
                text: "REGISTRO PROFESIONAL"
                font_size: "17sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: "3dp"

            BoxLayout:
                orientation: "vertical"
                padding: ["18dp", "18dp", "18dp", "40dp"]
                spacing: "10dp"
                size_hint_y: None
                height: self.minimum_height

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["16dp", "14dp"]
                    spacing: "10dp"
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14]

                    Label:
                        text: "Datos personales"
                        font_size: "14sp"
                        bold: True
                        color: 0.23, 0.18, 0.55, 1
                        size_hint_y: None
                        height: "24dp"
                        halign: "left"
                        text_size: self.size

                    Label:
                        text: "NOMBRE COMPLETO *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: nombre
                        hint_text: "Dr/Dra. Nombre Apellido"
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "EMAIL *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: email
                        hint_text: "tu@email.com"
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "TELEFONO"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: telefono
                        hint_text: "+54 9 xxx-xxxxxxx"
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["16dp", "14dp"]
                    spacing: "10dp"
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14]

                    Label:
                        text: "Datos profesionales"
                        font_size: "14sp"
                        bold: True
                        color: 0.23, 0.18, 0.55, 1
                        size_hint_y: None
                        height: "24dp"
                        halign: "left"
                        text_size: self.size

                    Label:
                        text: "MATRICULA *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: matricula
                        hint_text: "Numero de matricula"
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "PROVINCIA *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: provincia
                        hint_text: "Ej: Buenos Aires, CABA, Cordoba..."
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "ANOS DE EXPERIENCIA"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: experiencia
                        hint_text: "Ej: 10 anos"
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "DESCRIPCION PROFESIONAL"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: descripcion
                        hint_text: "Contanos sobre tu experiencia..."
                        multiline: True
                        size_hint_y: None
                        height: "80dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        padding: ["12dp", "12dp"]
                        font_size: "14sp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["16dp", "14dp"]
                    spacing: "8dp"
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14]

                    Label:
                        text: "Especialidades *"
                        font_size: "14sp"
                        bold: True
                        color: 0.23, 0.18, 0.55, 1
                        size_hint_y: None
                        height: "24dp"
                        halign: "left"
                        text_size: self.size

                    Label:
                        text: "1ra especialidad incluida. Cada adicional: $10.000"
                        font_size: "11sp"
                        color: 0.55, 0.58, 0.65, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    GridLayout:
                        id: grid_especialidades
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "6dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "70dp"
                    padding: ["16dp", "12dp"]
                    spacing: "4dp"
                    canvas.before:
                        Color:
                            rgba: 0.23, 0.18, 0.55, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14]

                    Label:
                        id: lbl_precio
                        text: "Total a pagar: $55.000"
                        font_size: "18sp"
                        bold: True
                        color: 1, 1, 1, 1
                        halign: "center"
                        text_size: self.size
                        size_hint_y: None
                        height: "28dp"

                    Label:
                        id: lbl_detalle_precio
                        text: "Suscripcion base (1 especialidad incluida)"
                        font_size: "11sp"
                        color: 0.85, 0.85, 1, 1
                        halign: "center"
                        text_size: self.size
                        size_hint_y: None
                        height: "18dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: ["16dp", "14dp"]
                    spacing: "10dp"
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14]

                    Label:
                        text: "CONTRASENA *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: password
                        hint_text: "Minimo 6 caracteres"
                        password: True
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        text: "REPETIR CONTRASENA *"
                        font_size: "11sp"
                        bold: True
                        color: 0.40, 0.45, 0.55, 1
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: password_confirm
                        hint_text: "Repeti tu contrasena"
                        password: True
                        multiline: False
                        size_hint_y: None
                        height: "46dp"
                        background_color: 0.96, 0.97, 0.98, 1
                        foreground_color: 0.10, 0.12, 0.18, 1
                        hint_text_color: 0.65, 0.68, 0.75, 1
                        cursor_color: 0.23, 0.18, 0.55, 1
                        padding: ["12dp", "12dp"]
                        font_size: "15sp"
                        write_tab: False

                    Label:
                        id: error
                        text: ""
                        color: 0.90, 0.25, 0.25, 1
                        size_hint_y: None
                        height: "36dp"
                        halign: "left"
                        text_size: self.size

                Button:
                    text: "Continuar al pago"
                    size_hint_y: None
                    height: "52dp"
                    bold: True
                    font_size: "16sp"
                    background_normal: ""
                    background_color: 0.23, 0.18, 0.55, 1
                    color: 1, 1, 1, 1
                    on_release: root.registrar()