#:import dp kivy.metrics.dp

<AdminPanelScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # HEADER
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(20), dp(12)]
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Panel Admin"
                font_size: "20sp"
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

            Button:
                text: "Salir"
                size_hint_x: None
                width: dp(80)
                background_color: 0.9, 0.2, 0.2, 1
                color: 1, 1, 1, 1
                on_release: root.volver()

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                padding: dp(20)
                spacing: dp(15)
                size_hint_y: None
                height: self.minimum_height

                # SECCION ABOGADOS
                Label:
                    text: "Gestion de Abogados"
                    font_size: "18sp"
                    bold: True
                    color: 0.10, 0.12, 0.18, 1
                    size_hint_y: None
                    height: dp(30)

                Label:
                    text: "Abogados Registrados"
                    font_size: "14sp"
                    color: 0.45, 0.50, 0.58, 1
                    size_hint_y: None
                    height: dp(20)

                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(4)
                    size_hint_y: None
                    height: dp(250)

                    GridLayout:
                        id: abogados_container
                        cols: 1
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                # SEPARADOR
                Widget:
                    size_hint_y: None
                    height: dp(10)

                BoxLayout:
                    size_hint_y: None
                    height: dp(2)
                    canvas.before:
                        Color:
                            rgba: 0.10, 0.12, 0.18, 0.2
                        Rectangle:
                            pos: self.pos
                            size: self.size

                Widget:
                    size_hint_y: None
                    height: dp(10)

                # SECCION RETIROS
                Label:
                    text: "Retiros Pendientes"
                    font_size: "18sp"
                    bold: True
                    color: 0.10, 0.12, 0.18, 1
                    size_hint_y: None
                    height: dp(30)

                Label:
                    text: "Transferi manualmente desde tu MercadoPago y apreta PAGAR"
                    font_size: "12sp"
                    color: 0.85, 0.55, 0.05, 1
                    size_hint_y: None
                    height: dp(20)

                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(4)
                    size_hint_y: None
                    height: dp(250)

                    GridLayout:
                        id: retiros_container
                        cols: 1
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                # SEPARADOR
                Widget:
                    size_hint_y: None
                    height: dp(10)

                BoxLayout:
                    size_hint_y: None
                    height: dp(2)
                    canvas.before:
                        Color:
                            rgba: 0.10, 0.12, 0.18, 0.2
                        Rectangle:
                            pos: self.pos
                            size: self.size

                Widget:
                    size_hint_y: None
                    height: dp(10)

                # SECCION PRECIOS
                Label:
                    text: "Configuracion de Precios"
                    font_size: "18sp"
                    bold: True
                    color: 0.10, 0.12, 0.18, 1
                    size_hint_y: None
                    height: dp(30)

                Label:
                    text: "Edita el precio y apreta Guardar para actualizar"
                    font_size: "12sp"
                    color: 0.45, 0.50, 0.58, 1
                    size_hint_y: None
                    height: dp(20)

                GridLayout:
                    id: precios_container
                    cols: 1
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height