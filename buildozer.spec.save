[app]
title = Legal App
package.name = legalapp
package.domain = com.legalapp.app
version = 1.0.0

source.dir = .
source.include_exts = py,kv,png,jpg,jpeg,svg,ttf,otf,json,sql
source.exclude_patterns = legal_app.db,.env,*.pyc,__pycache__,*.spec,tests/*,*.md

requirements = python3,kivy,kivymd,pillow,requests

orientation = portrait

android.permissions = INTERNET,CAMERA,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE,VIBRATE

android.minapi = 26
android.targetapi = 34
android.ndk = 25c

# AAB para Google Play
android.release_artifact = aab

# HTTPS forzado
android.network_security_config = network_security_config.xml

icon.filename      = assets/icon_512.png
presplash.filename = assets/splash_1080.png

log_level = 1
warn_on_root = 1

[buildozer]
log_level = 1
warn_on_root = 1
