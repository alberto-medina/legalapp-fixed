#:import dp kivy.metrics.dp

<PagoScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.97, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # =================================================
        # TOPBAR
        # =================================================

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(12), dp(10), dp(16), dp(10)]

            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "<"
                size_hint_x: None
                width: dp(36)
                font_size: "22sp"
                bold: True
                background_color: 0,0,0,0
                color: 1,1,1,1
                on_release: root.volver()

            Label:
                text: "CONFIRMAR PAGO"
                font_size: "16sp"
                bold: True
                color: 1,1,1,1
                halign: "left"
                text_size: self.size

        # =================================================
        # INFO ABOGADO
        # =================================================

        BoxLayout:
            size_hint_y: None
            height: dp(74)
            padding: [dp(18), dp(12)]

            canvas.before:
                Color:
                    rgba: 1,1,1,1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                id: lbl_abogado_info
                text: ""
                font_size: "13sp"
                color: 0.40, 0.45, 0.55, 1
                halign: "left"
                valign: "middle"
                text_size: self.size

        # =================================================
        # CONTENIDO
        # =================================================

        ScrollView:

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(22), dp(26)]
                spacing: dp(18)

                # =========================================
                # PRECIO
                # =========================================

                Label:
                    id: lbl_precio_grande
                    text: "$0"
                    font_size: "58sp"
                    bold: True
                    color: 0.10, 0.12, 0.18, 1
                    size_hint_y: None
                    height: dp(84)
                    halign: "center"
                    text_size: self.size

                Label:
                    id: lbl_tipo_desc
                    text: ""
                    font_size: "14sp"
                    color: 0.45, 0.50, 0.58, 1
                    size_hint_y: None
                    height: dp(52)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                # =========================================
                # RESUMEN
                # =========================================

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(120)
                    padding: [dp(18), dp(16)]

                    canvas.before:
                        Color:
                            rgba: 1,1,1,1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(18)]

                    Label:
                        text: "Resumen"
                        font_size: "15sp"
                        bold: True
                        color: 0.10, 0.12, 0.18, 1
                        size_hint_y: None
                        height: dp(24)
                        halign: "left"
                        text_size: self.size

                    Label:
                        id: lbl_resumen
                        text: ""
                        font_size: "12sp"
                        color: 0.45, 0.50, 0.58, 1
                        halign: "left"
                        valign: "top"
                        text_size: self.size

                # =========================================
                # ERROR MP
                # =========================================

                Label:
                    id: lbl_error_mp
                    text: ""
                    font_size: "12sp"
                    bold: True
                    color: 0.85, 0.30, 0.30, 1
                    size_hint_y: None
                    height: max(dp(24), self.texture_size[1] + dp(8)) if self.text else 0
                    halign: "center"
                    text_size: self.width, None

                # =========================================
                # BOTON PAGO
                # =========================================

                Button:
                    id: btn_pago_unico
                    text: "CONFIRMAR PAGO"
                    size_hint_y: None
                    height: dp(62)
                    font_size: "16sp"
                    bold: True
                    background_normal: ""
                    background_color: 0.18, 0.80, 0.44, 1
                    color: 1,1,1,1
                    on_release: root.pagar()

                Label:
                    text: "Pago seguro • MercadoPago • Acreditacion inmediata"
                    font_size: "11sp"
                    color: 0.60, 0.63, 0.70, 1
                    size_hint_y: None
                    height: dp(22)
                    halign: "center"
                    text_size: self.size

                Widget:
                    size_hint_y: None
                    height: dp(16)

        # =================================================
        # FOOTER
        # =================================================

        Button:
            text: "Cambiar tipo de consulta"
            size_hint_y: None
            height: dp(48)
            font_size: "13sp"
            background_color: 0,0,0,0
            color: 0.45, 0.50, 0.58, 1
            on_release:
                root.manager.current = "tipo"
