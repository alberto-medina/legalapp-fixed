rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USUARIOS
    // ============================================================
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.rol == 'abogado' && resource.data.estado_abogado == 'disponible')
      );
      allow write: if request.auth != null && (
        (request.auth.uid == userId && validarUpdateUsuario()) ||
        isAdmin()
      );
    }

    // ============================================================
    // CONSULTAS
    // ============================================================
    match /consultas/{consultaId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.cliente_uid ||
        request.auth.uid == resource.data.abogado_uid ||
        isAdmin()
      );

      allow create: if request.auth != null
        && request.resource.data.cliente_uid == request.auth.uid
        && request.resource.data.keys().hasAll(['cliente_uid', 'abogado_uid', 'tipo_servicio', 'estado', 'monto', 'created_at'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 50000;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.cliente_uid ||
        request.auth.uid == resource.data.abogado_uid ||
        isAdmin()
      ) && validarTransicionEstado(
        resource.data.estado,
        request.resource.data.estado,
        request.auth.uid,
        resource.data.cliente_uid,
        resource.data.abogado_uid
      )
      && request.resource.data.cliente_uid == resource.data.cliente_uid
      && request.resource.data.abogado_uid == resource.data.abogado_uid
      && request.resource.data.monto == resource.data.monto;

      allow delete: if isAdmin();
    }

    // ============================================================
    // MENSAJES
    // ============================================================
    match /consultas/{consultaId}/mensajes/{mensajeId} {
      allow read: if request.auth != null && esParticipante(consultaId);

      allow create: if request.auth != null
        && esParticipante(consultaId)
        && request.resource.data.remitente_uid == request.auth.uid
        && request.resource.data.keys().hasAll(['remitente_uid', 'texto', 'timestamp'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000;

      allow update, delete: if false;
    }

    // ============================================================
    // RESENAS
    // ============================================================
    match /resenas/{resenaId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.cliente_uid == request.auth.uid
        && existeConsultaFinalizada(request.resource.data.consulta_id, request.auth.uid)
        && request.resource.data.keys().hasAll(['consulta_id', 'cliente_uid', 'abogado_uid', 'puntuacion', 'comentario', 'timestamp'])
        && request.resource.data.puntuacion >= 1
        && request.resource.data.puntuacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500;

      allow update, delete: if false;
    }

    // ============================================================
    // RETIROS
    // ============================================================
    match /retiros/{retiroId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.abogado_uid || isAdmin()
      );

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.abogado_uid
        && request.resource.data.keys().hasAll(['abogado_uid', 'monto', 'estado', 'cbu', 'timestamp'])
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 100000
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.cbu is string
        && request.resource.data.cbu.size() == 22;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'procesado_at', 'admin_uid']);

      allow delete: if false;
    }

    // ============================================================
    // TRANSACCIONES
    // ============================================================
    match /users/{userId}/transacciones/{transaccionId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['tipo', 'monto', 'descripcion', 'timestamp'])
        && request.resource.data.monto > 0;
      allow update, delete: if false;
    }

    // ============================================================
    // VERIFICACIONES
    // ============================================================
    match /verificaciones/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ============================================================
    // NOTIFICACIONES
    // ============================================================
    match /notificaciones/{notifId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.destinatario_uid || isAdmin()
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.remitente_uid || isAdmin()
      );
      allow update: if request.auth != null && request.auth.uid == resource.data.destinatario_uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida', 'leida_at']);
      allow delete: if false;
    }

    // ============================================================
    // CONFIG
    // ============================================================
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================================
    // FUNCIONES AUXILIARES
    // ============================================================

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function esParticipante(consultaId) {
      let consulta = get(/databases/$(database)/documents/consultas/$(consultaId));
      return request.auth.uid == consulta.data.cliente_uid ||
             request.auth.uid == consulta.data.abogado_uid;
    }

    function validarUpdateUsuario() {
      let camposProhibidos = ['rol', 'uid', 'email_verificado', 'balance', 'total_ganado'];
      let camposCambiados = request.resource.data.diff(resource.data).affectedKeys();
      return !camposCambiados.hasAny(camposProhibidos);
    }

    function validarTransicionEstado(estadoActual, estadoNuevo, uidAuth, uidCliente, uidAbogado) {
      let esCliente = uidAuth == uidCliente;
      let esAbogado = uidAuth == uidAbogado;

      let clientePuedePagar = esCliente && estadoActual == 'pendiente' && estadoNuevo == 'pagado';
      let abogadoPuedeIniciar = esAbogado && estadoActual == 'pagado' && estadoNuevo == 'en_curso';
      let cualquieraPuedeFinalizar = estadoActual == 'en_curso' && estadoNuevo == 'finalizado';
      let adminPuedeTodo = isAdmin();

      return clientePuedePagar || abogadoPuedeIniciar || cualquieraPuedeFinalizar || adminPuedeTodo;
    }

    function existeConsultaFinalizada(consultaId, clienteUid) {
      let consulta = get(/databases/$(database)/documents/consultas/$(consultaId));
      return consulta.data.cliente_uid == clienteUid && consulta.data.estado == 'finalizado';
    }

  }
}