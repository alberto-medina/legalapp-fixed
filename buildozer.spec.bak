[app]

title = Legal App
package.name = legalapp
package.domain = com.legalapp.app
version = 1.0.1

source.dir = .
source.include_exts = py,kv,png,jpg,jpeg,svg,ttf,otf,json,sql
source.exclude_patterns = legal_app.db,.env,*.pyc,__pycache__,*.spec,tests/*,*.md

requirements = python3,kivy,kivymd,pillow,requests,firebase-admin,pyjnius,certifi,urllib3,charset-normalizer,idna

orientation = portrait

android.permissions = INTERNET,CAMERA,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE,VIBRATE,WAKE_LOCK,RECEIVE_BOOT_COMPLETED,POST_NOTIFICATIONS

android.minapi = 26
android.targetapi = 34
android.ndk = 25c

# AAB para Google Play
android.release_artifact = apk

# HTTPS forzado
android.network_security_config = network_security_config.xml

# Dependencias de Gradle para FCM
android.gradle_dependencies = com.google.firebase:firebase-messaging:23.4.0,com.google.firebase:firebase-analytics:21.5.0

# Plugin de Google Services
android.gradle_plugins = com.google.gms.google-services

icon.filename      = assets/icon_512.png
presplash.filename = assets/splash_1080.png

log_level = 2
warn_on_root = 1

[buildozer]
log_level = 2
warn_on_root = 1