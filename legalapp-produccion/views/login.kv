#:import dp kivy.metrics.dp

<LoginScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # HEADER
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(180)
            padding: dp(20), dp(24)
            spacing: dp(4)
            canvas.before:
                Color:
                    rgba: 0.24, 0.17, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Widget:
                size_hint_y: 0.4

            Label:
                id: titulo_app
                text: "LEGAL APP"
                font_size: "34sp"
                bold: True
                color: 1,1,1,1
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: dp(44)

            Label:
                text: "Tu consulta legal en minutos"
                font_size: "16sp"
                color: 0.85,0.82,0.96,1
                halign: "center"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: dp(24)

            Widget:
                size_hint_y: 0.3

        # BODY
        ScrollView:
            id: login_scroll
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(20), dp(20), dp(20) + app.keyboard_height]
                spacing: dp(12)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    size_hint_x: 1
                    canvas.before:
                        Color:
                            rgba: 0,0,0,0.07
                        RoundedRectangle:
                            pos: self.x, self.y - dp(3)
                            size: self.size
                            radius: [dp(24)]
                        Color:
                            rgba: 1,1,1,1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(26), dp(26)
                        spacing: dp(12)

                        Label:
                            text: "Iniciar sesion"
                            font_size: "22sp"
                            bold: True
                            color: 0.10,0.06,0.14,1
                            halign: "left"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: dp(34)

                        # CAMPO EMAIL con icono
                        FloatLayout:
                            size_hint_y: None
                            height: dp(56)

                            TextInput:
                                id: email
                                hint_text: "ejemplo@correo.com"
                                multiline: False
                                font_size: "16sp"
                                padding: dp(52), dp(16), dp(14), dp(16)
                                background_normal: ""
                                background_active: ""
                                background_color: 0.95,0.94,0.97,1
                                foreground_color: 0.10,0.06,0.14,1
                                hint_text_color: 0.60,0.57,0.68,1
                                cursor_color: 0.30,0.23,0.67,1
                                size_hint: None, None
                                size: self.parent.size
                                pos: self.parent.pos

                            FloatLayout:
                                size_hint: None, None
                                size: dp(32), dp(32)
                                pos: self.parent.x + dp(10), self.parent.center_y - self.height / 2
                                canvas.before:
                                    Color:
                                        rgba: 0.90, 0.87, 0.98, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(10)]

                                Label:
                                    text: "@"
                                    bold: True
                                    font_size: "17sp"
                                    color: 0.30, 0.23, 0.67, 1
                                    size_hint: None, None
                                    size: self.parent.size
                                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        # CAMPO PASSWORD CON ICONO Y OJO
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(56)
                            spacing: dp(4)

                            FloatLayout:
                                size_hint_x: 1

                                TextInput:
                                    id: password
                                    hint_text: "Contrasena"
                                    password: True
                                    multiline: False
                                    font_size: "16sp"
                                    padding: dp(52), dp(16), dp(14), dp(16)
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0.95,0.94,0.97,1
                                    foreground_color: 0.10,0.06,0.14,1
                                    hint_text_color: 0.60,0.57,0.68,1
                                    cursor_color: 0.30,0.23,0.67,1
                                    on_focus: root._on_password_focus(self, self.focus)
                                    size_hint: None, None
                                    size: self.parent.size
                                    pos: self.parent.pos

                                FloatLayout:
                                    size_hint: None, None
                                    size: dp(32), dp(32)
                                    pos: self.parent.x + dp(10), self.parent.center_y - self.height / 2
                                    canvas.before:
                                        Color:
                                            rgba: 0.90, 0.87, 0.98, 1
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [dp(10)]
                                        # Icono de "ojo de cerradura" (candado
                                        # simplificado): circulo + tallo,
                                        # mismo estilo simple y seguro que el
                                        # resto de los iconos hechos a mano.
                                        Color:
                                            rgba: 0.30, 0.23, 0.67, 1
                                        Ellipse:
                                            pos: self.center_x - dp(4), self.center_y + dp(1)
                                            size: dp(8), dp(8)
                                        RoundedRectangle:
                                            pos: self.center_x - dp(2.5), self.center_y - dp(7)
                                            size: dp(5), dp(8)
                                            radius: [dp(1.5)]

                            Button:
                                size_hint_x: None
                                width: dp(62)
                                text: ""
                                background_normal: ""
                                background_color: 0, 0, 0, 0
                                canvas.before:
                                    Color:
                                        rgba: 0.90,0.89,0.97,1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(10)]
                                # Icono de ojito (ver/ocultar contrasena),
                                # en canvas.after por el mismo motivo que el
                                # logo de Google -- con background_normal/
                                # down vacios, dibujar en canvas.before puede
                                # no renderizar.
                                canvas.after:
                                    Color:
                                        rgba: 0.30, 0.23, 0.67, 1
                                    Line:
                                        ellipse: (self.center_x - dp(10), self.center_y - dp(6), dp(20), dp(12))
                                        width: dp(1.6)
                                    Ellipse:
                                        pos: self.center_x - dp(3), self.center_y - dp(3)
                                        size: dp(6), dp(6)
                                    Line:
                                        points: [self.center_x - dp(10), self.center_y - dp(7), self.center_x + dp(10), self.center_y + dp(7)] if password.password else []
                                        width: dp(1.8)
                                on_release: password.password = not password.password

                        Label:
                            id: error
                            text: ""
                            color: 0.85,0.22,0.22,1
                            font_size: "13sp"
                            halign: "center"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: dp(18)

                        Button:
                            text: "Ingresar"
                            size_hint_y: None
                            height: dp(56)
                            font_size: "18sp"
                            bold: True
                            background_normal: ""
                            background_down: ""
                            background_color: 0, 0, 0, 0
                            color: 1,1,1,1
                            canvas.before:
                                Color:
                                    rgba: 0.30,0.23,0.67,1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(14)]
                            on_release: root.login()

                        Label:
                            text: "o"
                            font_size: "13sp"
                            color: 0.60,0.63,0.70,1
                            halign: "center"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: dp(20)

                        Button:
                            text: "Continuar con Google"
                            padding: dp(40), 0
                            size_hint_y: None
                            height: dp(52)
                            font_size: "15sp"
                            bold: True
                            background_normal: ""
                            background_down: ""
                            background_color: 1,1,1,1
                            color: 0.20,0.20,0.22,1
                            canvas.before:
                                Color:
                                    rgba: 0.82,0.83,0.87,1
                                Line:
                                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
                                    width: dp(1.2)
                            # Logo de Google: imagen generada. Tiene que ir en
                            # canvas.after, no canvas.before -- con
                            # background_normal/down vacios (como este boton),
                            # un Rectangle con imagen puesto en canvas.before
                            # despues de eso no se dibuja (comprobado con test
                            # aislado); en canvas.after si funciona.
                            canvas.after:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: "assets/google_logo.png"
                                    pos: self.x + dp(20), self.center_y - dp(10)
                                    size: dp(20), dp(20)
                            on_release: root.login_con_google()

                        Label:
                            text: "Solo para clientes. Los abogados deben crear su cuenta como profesional."
                            font_size: "11sp"
                            color: 0.55,0.58,0.65,1
                            size_hint_y: None
                            height: dp(28)
                            halign: "center"
                            valign: "middle"
                            text_size: self.width, None

                        # Crear cuenta: separado en dos botones bien
                        # visibles (Cliente/Abogado) en vez de uno solo
                        # que llevaba primero al formulario de cliente --
                        # los abogados terminaban sin encontrar su
                        # registro (estaba escondido como link abajo del
                        # formulario de cliente) y por confusion tocaban
                        # "Continuar con Google", que es solo para clientes.
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(52)
                            spacing: dp(10)

                            Button:
                                text: "Soy Cliente"
                                font_size: "15sp"
                                bold: True
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0
                                color: 0.30,0.23,0.67,1
                                canvas.before:
                                    Color:
                                        rgba: 0.90, 0.87, 0.98, 1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(14)]
                                on_release: root.go_register()

                            Button:
                                text: "Soy Abogado"
                                font_size: "15sp"
                                bold: True
                                background_normal: ""
                                background_down: ""
                                background_color: 0, 0, 0, 0
                                color: 1,1,1,1
                                canvas.before:
                                    Color:
                                        rgba: 0.30,0.23,0.67,1
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(14)]
                                on_release: root.ir_registro_abogado()

                        Button:
                            text: "No recibi el codigo de verificacion"
                            size_hint_y: None
                            height: dp(44)
                            font_size: "14sp"
                            background_normal: ""
                            background_down: ""
                            background_color: 1,1,1,1
                            color: 0.50,0.47,0.58,1
                            on_release: root.reenviar_codigo()

                        Button:
                            text: "Olvide mi contrasena"
                            size_hint_y: None
                            height: dp(40)
                            font_size: "13sp"
                            background_normal: ""
                            background_down: ""
                            background_color: 1,1,1,1
                            color: 0.30,0.23,0.67,1
                            on_release: root.recuperar_password()
