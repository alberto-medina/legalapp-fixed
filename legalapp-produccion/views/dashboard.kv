#:import dp kivy.metrics.dp

<DashboardScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: 0.96, 0.95, 0.98, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # =========================
        # TOPBAR
        # =========================
        BoxLayout:
            size_hint_y: None
            height: dp(92)
            padding: [dp(20), dp(18), dp(20), dp(16)]
            spacing: dp(10)

            canvas.before:
                Color:
                    rgba: 0.24, 0.17, 0.55, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "LEGAL APP"
                bold: True
                color: 1, 1, 1, 1
                font_size: "24sp"
                halign: "left"
                valign: "middle"
                text_size: self.width, self.height
                on_touch_down:
                    if self.collide_point(*args[1].pos): root.on_tap_titulo()

            Button:
                text: "Avisos"
                size_hint: None, None
                size: dp(58), dp(38)
                font_size: "11sp"
                bold: True
                background_normal: ""
                background_color: 0.35, 0.28, 0.70, 1
                color: 1, 1, 1, 1
                on_release: root.ver_notificaciones()

            AsyncImage:
                id: img_avatar_inicio
                size_hint: None, None
                size: dp(42), dp(42)
                source: "assets/avatar_default.png"
                allow_stretch: True
                keep_ratio: True

            BoxLayout:
                orientation: "vertical"
                size_hint_x: .60

                Label:
                    id: lbl_bienvenida
                    text: ""
                    bold: True
                    color: 1, 1, 1, 1
                    font_size: "15sp"
                    halign: "right"
                    valign: "bottom"
                    text_size: self.width, self.height

                Label:
                    text: "Cliente"
                    color: 0.75, 0.72, 0.92, 1
                    font_size: "13sp"
                    halign: "right"
                    valign: "top"
                    text_size: self.width, self.height

        # =========================
        # CONTENIDO
        # =========================
        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                orientation: "vertical"
                spacing: dp(18)
                padding: [dp(20), dp(20), dp(20), dp(24)]
                size_hint_y: None
                height: self.minimum_height

                # =========================
                # HERO CARD
                # =========================
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(220)
                    padding: dp(26), dp(24)
                    spacing: dp(12)

                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.08
                        RoundedRectangle:
                            pos: self.x + 3, self.y - 4
                            size: self.width - 6, self.height
                            radius: [dp(24)]
                        Color:
                            rgba: 0.30, 0.23, 0.67, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(24)]

                    Label:
                        text: "Hola, bienvenido"
                        size_hint_y: None
                        height: dp(26)
                        color: 0.82, 0.79, 0.96, 1
                        font_size: "15sp"
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None

                    Label:
                        text: "Como podemos ayudarte?"
                        size_hint_y: None
                        height: dp(42)
                        bold: True
                        color: 1, 1, 1, 1
                        font_size: "26sp"
                        halign: "left"
                        valign: "middle"
                        text_size: self.width, None

                    Widget:

                    Button:
                        text: "Nueva Consulta"
                        size_hint_y: None
                        height: dp(60)
                        bold: True
                        font_size: "17sp"
                        background_normal: ""
                        background_color: 1, 1, 1, 1
                        color: 0.30, 0.23, 0.67, 1
                        on_release: root.nueva_consulta()

                # =========================
                # VIDEOLLAMADA
                # =========================
                Button:
                    id: btn_video
                    text: "Unirse a videollamada"
                    size_hint_y: None
                    height: dp(54)
                    opacity: 0
                    disabled: True
                    bold: True
                    font_size: "15sp"
                    background_normal: ""
                    background_color: 0.85, 0.18, 0.18, 1
                    color: 1, 1, 1, 1
                    on_release: root.ir_video(0)

                # =========================
                # TITULO
                # =========================
                Label:
                    text: "Acciones rapidas"
                    size_hint_y: None
                    height: self.texture_size[1]
                    bold: True
                    color: 0.45, 0.40, 0.55, 1
                    font_size: "14sp"
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None

                # =========================
                # CARD CONSULTAS
                # =========================
                BoxLayout:
                    size_hint_y: None
                    height: dp(112)
                    padding: dp(18)
                    spacing: dp(14)

                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.06
                        RoundedRectangle:
                            pos: self.x + 2, self.y - 3
                            size: self.width - 4, self.height
                            radius: [dp(20)]
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20)]

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: 1

                        Label:
                            text: "Mis Consultas"
                            bold: True
                            color: 0.10, 0.06, 0.14, 1
                            font_size: "17sp"
                            halign: "left"
                            valign: "bottom"
                            text_size: self.width, self.height

                        Label:
                            text: "Ver historial y estado"
                            color: 0.55, 0.50, 0.65, 1
                            font_size: "13sp"
                            halign: "left"
                            valign: "top"
                            text_size: self.width, self.height

                    Button:
                        text: "Ver"
                        size_hint_x: None
                        width: dp(96)
                        bold: True
                        font_size: "15sp"
                        background_normal: ""
                        background_color: 0.30, 0.23, 0.67, 1
                        color: 1, 1, 1, 1
                        on_release: root.ver_historial()

                # =========================
                # CARD PERFIL
                # =========================
                BoxLayout:
                    size_hint_y: None
                    height: dp(112)
                    padding: dp(18)
                    spacing: dp(14)

                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.06
                        RoundedRectangle:
                            pos: self.x + 2, self.y - 3
                            size: self.width - 4, self.height
                            radius: [dp(20)]
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20)]

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: 1

                        Label:
                            text: "Mi Perfil"
                            bold: True
                            color: 0.10, 0.06, 0.14, 1
                            font_size: "17sp"
                            halign: "left"
                            valign: "bottom"
                            text_size: self.width, self.height

                        Label:
                            text: "Editar datos personales"
                            color: 0.55, 0.50, 0.65, 1
                            font_size: "13sp"
                            halign: "left"
                            valign: "top"
                            text_size: self.width, self.height

                    Button:
                        text: "Editar"
                        size_hint_x: None
                        width: dp(96)
                        bold: True
                        font_size: "15sp"
                        background_normal: ""
                        background_color: 0.30, 0.23, 0.67, 1
                        color: 1, 1, 1, 1
                        on_release: root.ir_perfil()

        # =========================
        # BOTTOM NAV
        # =========================
        BoxLayout:
            size_hint_y: None
            height: dp(82)

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.85, 0.82, 0.94, 1
                Line:
                    points: [self.x, self.top, self.right, self.top]
                    width: 1.2

            BoxLayout:
                orientation: "vertical"
                padding: dp(6)
                canvas.before:
                    Color:
                        rgba: 0.92, 0.89, 0.98, 1
                    RoundedRectangle:
                        pos: self.x + 4, self.y + 4
                        size: self.width - 8, self.height - 8
                        radius: [dp(16)]

                Label:
                    text: "Inicio"
                    bold: True
                    color: 0.30, 0.23, 0.67, 1
                    font_size: "13sp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.width, self.height

            Button:
                text: "Consultas"
                bold: True
                font_size: "13sp"
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 0.50, 0.46, 0.62, 1
                on_release: root.ver_historial()

            Button:
                text: "Perfil"
                bold: True
                font_size: "13sp"
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 0.50, 0.46, 0.62, 1
                on_release: root.ir_perfil()

            Button:
                text: "Salir"
                bold: True
                font_size: "13sp"
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 0.80, 0.25, 0.25, 1
                on_release: root.cerrar_sesion()
